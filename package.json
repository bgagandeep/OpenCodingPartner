{
  "name": "opencodingpartner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc -b",
    "app": "tsc -b && node packages/cli/dist/main.js app",
    "test": "tsc -b && corepack pnpm install --offline && node --test --test-reporter spec $(find packages tests \\( -name '*.test.js' -o -name '*.test.mjs' \\))",
    "demo": "tsc -b && node packages/cli/dist/main.js demo --sandbox .sandbox",
    "demo:connected": "tsc -b && node packages/cli/dist/main.js demo --live --sandbox .sandbox",
    "bundle:install": "tsc -b && node packages/bundle/dist/install.js",
    "bundle:install:laya": "tsc -b && node packages/bundle/dist/install.js --laya-only",
    "bundle:plan": "tsc -b && node packages/bundle/dist/install.js --dry-run",
    "proof:coding": "tsc -b && node scripts/proof-coding.mjs",
    "prove:coding": "tsc -b && node packages/cli/dist/main.js prove coding",
    "prove:computer": "tsc -b && node packages/cli/dist/main.js prove computer"
  },
  "dependencies": {
    "@opencodingpartner/cli": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
